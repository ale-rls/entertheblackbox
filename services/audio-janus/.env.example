# Host address reachable by the audience phones, not a Docker container IP.
JANUS_PUBLIC_IP=192.168.1.50
# 8–64 letters/digits. This is shared rehearsal access, not participant identity.
JANUS_LISTENER_PIN=replace-with-your-pin
JANUS_WEB_BIND=127.0.0.1
JANUS_WEB_PORT=8400
JANUS_INPUT_PORT=9900

# Generate different random secrets, e.g. openssl rand -hex 32
JANUS_ADMIN_KEY=replace-with-a-random-management-secret
JANUS_BRIDGE_TOKEN=replace-with-a-different-random-bridge-secret
JANUS_PLAYERS=30
JANUS_BRIDGE_BIND=127.0.0.1
JANUS_BRIDGE_PORT=8500
