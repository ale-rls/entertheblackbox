# copy to .env and change every password before a show
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
# ICECAST_RELAY_PASSWORD defaults to the source password

# hostname phones will use (the venue box's LAN IP)
ICECAST_HOSTNAME=localhost
# Host ports avoid TrackingBox (8000), PocketBase (8090), and the runner (8100).
ICECAST_PUBLIC_PORT=8200
BRIDGE_PUBLIC_PORT=8300
# public bridge base handed out in status payloads, e.g. http://192.168.1.10:8300
# In production put this behind HTTPS when the phone frontend is HTTPS.
PUBLIC_STREAM_BASE=

# players: either a count (ids "1".."N") ...
PLAYERS=100
# ... or an explicit comma-separated id list (wins over PLAYERS if set).
# Runtime participant IDs are assigned dynamically to this fixed pool.
PLAYER_IDS=

# Bridge storage. The server uploads Studio media here before playback.
AUDIO_DIR=./audio
BEDS_DIR=./beds

# bearer token the canonical server uses to call the bridge (empty = no auth, dev only)
BRIDGE_TOKEN=

# claimed player with 0 listeners for this long => flagged red (SPEC §8)
FLAG_AFTER_S=20

# maximum authenticated runner upload size per MP3
MAX_AUDIO_UPLOAD_MB=20
