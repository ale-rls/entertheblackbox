# copy to .env and change every password before a show
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
# ICECAST_RELAY_PASSWORD defaults to the source password

# hostname phones will use (the venue box's LAN IP)
ICECAST_HOSTNAME=localhost
# absolute stream base handed out in bridge status payloads, e.g. http://192.168.1.10:8000
PUBLIC_STREAM_BASE=

# players: either a count (ids "1".."N") ...
PLAYERS=100
# ... or an explicit comma-separated id list (wins over PLAYERS if set).
# Must match blackbox-runner's player page ids ([A-Za-z0-9_-]+).
PLAYER_IDS=

# narration files — point at blackbox-runner's audio dir in production:
# AUDIO_DIR=../blackbox-runner/content/audio
AUDIO_DIR=./audio
BEDS_DIR=./beds

# bearer token blackbox-runner uses to call the bridge (empty = no auth, dev only)
BRIDGE_TOKEN=

# claimed player with 0 listeners for this long => flagged red (SPEC §8)
FLAG_AFTER_S=20
