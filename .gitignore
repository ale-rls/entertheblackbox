node_modules/
dist/
dist-proof/
.watchdog/
.steps.lock/
.env
.env.*
*.log
.DS_Store
# Real show media stays out of git (production media is externally hosted);
# the tiny fake dev fixture is tracked so validation, tests, and fresh
# clones work (CI runs validate-scenario against dev.json).
content/media/*
!content/media/intro.mp4
# ...except this production's own narration audio and stills, which are small,
# needed to run the show, and ours to publish. Video stays out: it is large and
# externally hosted.
!content/media/*.mp3
!content/media/*.png
!content/media/*.jpg

# Script drafts and other written show content stay out of git. This is a
# public repository; an unproduced script does not belong in it.
*Ablauf*.txt
/script/
/scripts-draft/

# Bundled display media (attract clips, credits render) is show content and
# stays out of git too. Drop the files in locally; the attract playlist is an
# import.meta.glob, so they are picked up without any code change. Fonts and
# logos are design assets, not show content, and remain tracked.
apps/display/src/assets/*.mp4
apps/display/src/assets/*.mp3
apps/display/src/assets/*.webm
apps/display/src/assets/*.mov

# Playwright artifacts
test-results/

# PocketBase local instance (binary is downloaded, data/logs are runtime state)
pocketbase/bin/
pocketbase/pb_data/
pocketbase/pb_logs/
pocketbase/.e2e-data/
