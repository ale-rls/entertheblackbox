[Unit]
Description=Enter the Blackbox fullscreen kiosk
Wants=network-online.target
After=network-online.target graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/etc/entertheblackbox/kiosk.env
ExecStart=/opt/entertheblackbox/scripts/kiosk/launch-kiosk.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
SyslogIdentifier=entertheblackbox-kiosk

# Browser session runs as the dedicated, unprivileged account.
User=entertheblackbox-kiosk
Group=entertheblackbox-kiosk

[Install]
WantedBy=graphical.target
