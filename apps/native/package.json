{
  "name": "@entertheblackbox/native",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export": "expo export --platform ios --platform android",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production"
  },
  "dependencies": {
    "@entertheblackbox/expo-audio-scheduler": "workspace:*",
    "@entertheblackbox/protocol": "workspace:*",
    "@entertheblackbox/shared": "workspace:*",
    "@entertheblackbox/show-content": "workspace:*",
    "expo": "~55.0.0",
    "expo-build-properties": "~55.0.18",
    "expo-crypto": "~55.0.0",
    "expo-dev-client": "~55.0.0",
    "expo-file-system": "~55.0.0",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.0",
    "expo-updates": "~55.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
