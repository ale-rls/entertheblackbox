{
  "name": "@entertheblackbox/midi-bridge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Runs on the sound MacBook: turns the show server's cue feed into MIDI for Ableton.",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "eventsource": "^5.1.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@julusian/midi": "3.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
