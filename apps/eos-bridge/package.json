{
  "name": "@entertheblackbox/eos-bridge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Runs on the laptop cabled to the ETC Eos/Nomad desk: turns the show server's cue feed into lighting looks over OSC.",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "eventsource": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
