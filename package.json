{
  "name": "entertheblackbox",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @entertheblackbox/display build && pnpm --filter @entertheblackbox/phone build && pnpm --filter @entertheblackbox/admin build && playwright test --config tests/e2e/playwright.config.ts",
    "validate-scenario": "tsx scripts/validate-scenario.ts",
    "build-media-manifest": "tsx scripts/build-media-manifest.ts",
    "generate-idle-marker-tracks": "python3 scripts/generate-idle-marker-tracks.py",
    "generate-crowd-sfx": "tsx scripts/generate-crowd-sfx.ts",
    "simulate-clients": "tsx scripts/simulate-clients.ts",
    "pocketbase:download": "pocketbase/scripts/download.sh",
    "pocketbase:dev": "pocketbase/scripts/dev.sh",
    "publish-scenario": "tsx scripts/publish-scenario-to-pocketbase.ts",
    "import-show-yaml": "tsx scripts/import-show-yaml.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "pocketbase": "^0.27.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
