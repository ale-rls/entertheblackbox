# Public URLs. Use HTTPS/WSS and no trailing slash except PHONE_JOIN_BASE_URL.
VITE_POCKETBASE_URL=https://pb.example.org
REALTIME_WS_URL=wss://bb-realtime.enabler.space
PHONE_JOIN_BASE_URL=https://play.example.org/phone/
PUBLIC_STREAM_BASE=https://audio.example.org
ICECAST_HOSTNAME=audio.example.org

# Installation identity.
INSTALLATION_ID=production
ROOM_ID=main
SHOW_ID=entertheblackbox

# Generate five different long random values. DISPLAY_TOKEN is supplied as
# both a build argument and runtime variable by Compose.
DISPLAY_TOKEN=replace-with-a-long-random-display-token
JOIN_GRANT_SECRET=replace-with-a-different-long-random-secret
BRIDGE_TOKEN=replace-with-a-third-long-random-secret
ICECAST_SOURCE_PASSWORD=replace-with-a-fourth-long-random-secret
ICECAST_ADMIN_PASSWORD=replace-with-a-fifth-long-random-secret

# Existing PocketBase superuser. Keep the persistent pocketbase-data volume.
POCKETBASE_ADMIN_EMAIL=admin@example.org
POCKETBASE_ADMIN_PASSWORD=replace-with-the-existing-superuser-password

# Capacity and policy defaults; prune these from Coolify if the defaults fit.
PLAYERS=100
MAX_PARTICIPANTS=100
MAX_WEBSOCKET_CONNECTIONS=300
ICECAST_MAX_CLIENTS=400
ICECAST_MAX_SOURCES=120
FLAG_AFTER_S=20
MAX_AUDIO_UPLOAD_MB=20
ALLOW_LATE_JOIN=true
SHOW_PHONE_JOIN_BASE_URL=true

# Optional overrides; leave commented to use the defaults above/in Compose.
# PLAYER_IDS=seat-a,seat-b
# JOIN_RATE_LIMIT_MAX_ATTEMPTS=30
# JOIN_RATE_LIMIT_WINDOW_MS=60000

# Leave unset unless the installation server can reach a TrackingBox URL.
# TRACKINGBOX_URL=http://trackingbox-host:8000

# Pinned image inputs; omit to use these defaults.
PB_VERSION=0.39.11
PB_ARCH=amd64
